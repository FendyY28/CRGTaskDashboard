    # Copy to .env and fill in real values. Never commit the real .env.

# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/bsi_crg_db?schema=public"

# Server Port
PORT=3000

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated list of allowed CORS origins, e.g. https://dashboard.bsi.co.id
CORS_ORIGINS="http://localhost:5173"

# Frontend base URL (used in verification / notification email links)
FRONTEND_URL="http://localhost:5173"

# SMTP Email Configuration (for OTP & Notifications)
MAIL_HOST="smtp.gmail.com"
MAIL_USER="your_email@gmail.com"
MAIL_PASS="your_gmail_app_password"
MAIL_FROM="your_email@gmail.com"

# Optional: Abstract API key for email deliverability check
ABSTRACT_API_KEY=""
