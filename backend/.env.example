# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit the real .env.
# Full reference: ../README.md#-environment-variables-env
#
# Minimum to run locally: DATABASE_URL + JWT_SECRET. Everything below them is
# optional — without SMTP, e-mails (OTP, temporary passwords, verification
# links) are printed in the backend console instead of being sent.
# ---------------------------------------------------------------------------

# Database Connection String (PostgreSQL)
# Docker (docker compose up -d postgres): postgres / superuser / bsi_crg_db
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/bsi_crg_db?schema=public"

# Server Port
PORT=3000

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated list of allowed CORS origins, e.g. https://dashboard.bsi.co.id
CORS_ORIGINS="http://localhost:5173"

# Frontend base URL (used in verification / notification email links)
FRONTEND_URL="http://localhost:5173"

# SMTP Email Configuration (for OTP & Notifications)
# Leave MAIL_USER / MAIL_PASS empty for local development: e-mails are then
# logged to the backend console. For Gmail use an App Password, not your login
# password: https://myaccount.google.com/apppasswords
MAIL_HOST="smtp.gmail.com"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="noreply@bsi-crg.local"

# Optional: Abstract API key for email deliverability check
# When empty, /auth/validate-email only checks the address format.
ABSTRACT_API_KEY=""
