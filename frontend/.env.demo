# Demo build configuration — loaded only by `npm run build:demo`.
#
# Vite reads `.env.demo` when it runs in "demo" mode, so a normal `npm run build`
# (mode: production) is completely unaffected and never bundles the fixtures.
#
# The demo build answers every API call from an in-memory fake backend
# (src/app/services/api.ts is aliased to src/app/dev/demoApi.ts in vite.config.ts):
# no NestJS, no PostgreSQL, nothing to deploy but static files.
VITE_DEMO_MODE=true

# Any value works — in demo mode no request ever leaves the browser. Keeping it
# in the API URL's shape avoids Vite warnings and matches the real app.
VITE_API_URL=http://localhost:3000
